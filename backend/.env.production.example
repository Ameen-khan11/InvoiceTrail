# Production Environment Variables for InvoiceTrail Backend
FLASK_ENV=production
SECRET_KEY=generate-a-strong-random-32-character-secret-key-here
JWT_SECRET_KEY=generate-a-strong-random-32-character-jwt-key-here

# Database URL:
# PostgreSQL example: postgresql://user:password@host:5432/invoicetrail
# MySQL example: mysql+pymysql://user:password@host:3306/invoicetrail
# SQLite example: sqlite:///invoicetrail_prod.db
DATABASE_URL=sqlite:///invoicetrail_prod.db

# CORS Allowed Origins (Comma separated frontend domain URLs)
CORS_ORIGINS=https://your-frontend-domain.com,https://invoicetrail.vercel.app

# Optional Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email Settings (for sending payment reminders)
MAIL_SERVER=smtp.mailgun.org
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=Invoices <no-reply@yourdomain.com>
